# Copie para .env e ajuste conforme necessário. Nunca versione o .env real.
DATABASE_PATH=data/monitoring.db
# Limites padrão das regras de alerta (podem ser sobrescritos por pipeline)
MAX_DURATION_SECONDS=300
MAX_ERROR_RATE=0.05
MIN_ROWS_EXPECTED=1
# Runs presos em 'running' há mais que isso disparam stale_running
MAX_RUNNING_SECONDS=1800
LOG_LEVEL=INFO
